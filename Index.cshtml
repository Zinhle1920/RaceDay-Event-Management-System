@model RaceDay.Mvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">
    <h2>Welcome, @Model.FirstName!</h2>
    <p>Discover upcoming races and register for your next challenge.</p>

    <h4 class="mb-3">Available Events</h4>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Events)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5>@item.EventName</h5>
                            <p>@item.Description</p>
                            <p><strong>Date:</strong> @item.EventDate.ToShortDateString()</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.Distance km</p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-primary">
                                View Event
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>