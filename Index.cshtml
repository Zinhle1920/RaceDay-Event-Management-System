@model RaceDay.Mvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h2>Welcome, @Model.FirstName!</h2>
    <p>Organiser Dashboard</p>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>My Events</h4>
        <a asp-controller="Events" asp-action="Create"
           class="btn btn-primary">Create Event</a>
    </div>

    @if (!Model.Events.Any())
    {
        <div class="alert alert-info">
            You haven't created any events yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Events)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5>@item.EventName</h5>
                            <p>@item.Description</p>
                            <p><strong>Date:</strong> @item.EventDate.ToShortDateString()</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.Distance km</p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-outline-primary">
                                Manage Event
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>