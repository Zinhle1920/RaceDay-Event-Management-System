@model List<ResultViewModel>

    @{
    ViewData["Title"] = "My Results";
    }

    <div class="container mt-4">

        <h2>My Race Results</h2>

        @if (Model.Any())
        {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Finish Time</th>
                    <th>Finish Position</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var result in Model)
                {
                <tr>
                    <td>@result.EventName</td>
                    <td>@(result.FinishTime?.ToString() ?? "Not recorded")</td>
                    <td>@(result.FinishPosition?.ToString() ?? "Not recorded")</td>
                </tr>
                }
            </tbody>
        </table>
        }
        else
        {
        <p>No results are available yet.</p>
        }

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>
