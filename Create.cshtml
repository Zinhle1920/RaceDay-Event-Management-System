@model CreateResultViewModel

@{
    ViewData["Title"] = "Record Result";
}

<div class="container mt-4">

    <h2>Record Race Result</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="EnrolmentId" />

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time
            </label>
            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="FinishPosition" class="form-label">
                Finish Position
            </label>
            <input asp-for="FinishPosition"
                   type="number"
                   min="1"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>