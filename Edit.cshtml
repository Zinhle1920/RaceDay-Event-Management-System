@model EventFormViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<h2>Edit Event</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.EventId" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventName" class="form-label">Event Name</label>
        <input asp-for="EventName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="EventDate" class="form-label">Event Date</label>
        <input asp-for="EventDate" type="datetime-local" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">Distance (km)</label>
        <input asp-for="Distance" type="number" step="0.1" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventTypeId" class="form-label">Event Type</label>
        <select asp-for="EventTypeId" class="form-select">
            @foreach (var type in Model.EventTypes)
            {
                <option value="@type.EventTypeId">@type.TypeName</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

</form>