@model List<OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4">

    <h2>Event Enrolments</h2>

    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Registration Date</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td>@enrolment.ParticipantName</td>
                        <td>@enrolment.CategoryName</td>
                        <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-primary">
                                @enrolment.Status
                            </span>
                        </td>
                        <td>
                            <form asp-action="UpdateStatus" method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@enrolment.EnrolmentId" />

                                <input type="hidden"
                                       name="eventId"
                                       value="@enrolment.EventId" />

                                <select name="status" class="form-select mb-2">
                                    <option value="Registered">Registered</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Completed">Completed</option>
                                </select>

                                <button type="submit"
                                        class="btn btn-sm btn-success">
                                    Update
                                </button>

                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No participants have registered for this event yet.</p>
    }

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@ViewBag.EventId"
       class="btn btn-secondary">
        Back to Event
    </a>

</div>